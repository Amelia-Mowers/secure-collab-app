# Cloudflare Pages headers for the tidework.io apex (landing + discovery).

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'none'

# The Matrix spec requires CORS on the client discovery document, and both
# must serve as JSON despite having no file extension.
/.well-known/matrix/*
  Access-Control-Allow-Origin: *
  Content-Type: application/json
