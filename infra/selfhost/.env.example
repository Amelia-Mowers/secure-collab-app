# Copy to `.env` and edit. `docker compose` reads it automatically.
#
# Only the first three need a decision; the rest have safe defaults and the
# secrets are generated for you by ./setup.sh.

# ── The one you cannot change later ─────────────────────────────────────────
# Your Matrix server name. It becomes the second half of every user ID on this
# server — `@alice:example.org` — and it is PERMANENT. Changing it later
# invalidates every account, room and device on the server. Use the bare
# domain, not a subdomain, unless you are certain.
TIDEWORK_SERVER_NAME=example.org

# Where Synapse actually answers, and what the TLS certificate is issued for.
# Conventionally a subdomain, so the apex is free for a website. If this differs
# from TIDEWORK_SERVER_NAME you must publish a delegation file — ./setup.sh
# prints the exact contents.
TIDEWORK_HOSTNAME=matrix.example.org

# Let's Encrypt sends expiry warnings here. Caddy obtains and renews the
# certificate automatically; nothing else to do.
TIDEWORK_ACME_EMAIL=you@example.org

# ── Defaults that are fine ──────────────────────────────────────────────────

# Postgres password. Generated by ./setup.sh if left as-is.
POSTGRES_PASSWORD=

# ── How people get accounts ─────────────────────────────────────────────────
#
# The default is INVITATION ONLY, which is these two together: registration is
# enabled, and every sign-up must present a token you minted. People sign
# themselves up in the app; nobody without an invitation can. ./bootstrap.sh
# gives you your first token, and ./make-token.sh mints more.
#
# The two alternatives, and why they are not the default:
#
#   Fully open   — set SYNAPSE_REGISTRATION_REQUIRES_TOKEN=false and leave
#                  SYNAPSE_OPEN_REGISTRATION=true. Anyone who finds this server
#                  can create an account, with no email, captcha or invitation.
#                  Synapse does NOT stop you. Open Matrix servers are found by
#                  automation within days, and an abused one gets defederated by
#                  other homeservers — which breaks the cross-server
#                  collaboration your users wanted, and is hard to undo.
#
#   Closed       — set SYNAPSE_OPEN_REGISTRATION=false. You create every account
#                  yourself with ./register-user.sh. Safest, and it stops being
#                  practical at about five people.
SYNAPSE_OPEN_REGISTRATION=true
SYNAPSE_REGISTRATION_REQUIRES_TOKEN=true

# Generated by ./setup.sh. Anyone holding this can create accounts.
SYNAPSE_REGISTRATION_SHARED_SECRET=

# Federation lets your users collaborate with people on other Matrix servers,
# and is the reason to run Matrix at all. Set to `false` for an island — your
# users can then only share workspaces with each other.
TIDEWORK_FEDERATION=true

# Written by ./setup.sh: the user that owns ./data, which Synapse runs as.
SYNAPSE_UID=
SYNAPSE_GID=

# Pinned deliberately. These are the versions TideWork's integration and
# end-to-end suites run against; see infra/selfhost/README.md before bumping.
SYNAPSE_IMAGE=matrixdotorg/synapse:v1.148.0
POSTGRES_IMAGE=postgres:16-alpine
CADDY_IMAGE=caddy:2-alpine
