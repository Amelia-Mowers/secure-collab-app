# Upstream social-login provider credentials (tier-2 secret).
#
# To enable Google sign-in:
#   1. Copy this file to  infra/secrets/upstream-oauth.sops.env
#   2. Fill in the Google OAuth client id + secret (Google Cloud Console →
#      APIs & Services → Credentials → OAuth 2.0 Client ID, type "Web application").
#      Register this Authorized redirect URI on that client:
#        https://auth.tidework.io/upstream/callback/1VAQ5RSM5FDRKEJMP69N81JBPW
#      (must match the provider `id` in infra/mas/config.yaml.tmpl)
#   3. Encrypt in place:  sops -e -i infra/secrets/upstream-oauth.sops.env
#      (uses the recipients in the repo-root .sops.yaml, path_regex infra/secrets/.* —
#      same two age recipients as the other *.sops.env; encryption needs only the
#      public keys, so no private key is required to create it)
#   4. Deploy:  powershell -File infra/deploy.ps1
#
# If this file is absent, remote-setup.sh drops the provider and MAS boots
# without social login (no breakage).

GOOGLE_OAUTH_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxx
