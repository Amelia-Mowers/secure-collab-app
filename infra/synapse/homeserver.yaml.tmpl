# Synapse configuration for the TideWork hosted homeserver.
# Rendered by infra/deploy.sh with envsubst — ${...} placeholders come from
# the sops-decrypted tier-2 secrets + deploy-time facts. Hand-written and
# minimal on purpose: every line here is a decision, not generator output.

# Identity: user IDs are @user:tidework.io (permanent — ADR 0002); clients
# and federation actually connect to matrix.tidework.io via .well-known
# delegation on the apex.
server_name: "tidework.io"
public_baseurl: "https://matrix.tidework.io/"

pid_file: /data/homeserver.pid
signing_key_path: "/data/tidework.io.signing.key"
media_store_path: /data/media_store
report_stats: false
suppress_key_server_warning: true

listeners:
  - port: 8008
    type: http
    tls: false
    x_forwarded: true # host nginx terminates TLS
    bind_addresses: ["0.0.0.0"] # container-internal; published on 127.0.0.1 only
    resources:
      - names: [client, federation]
        compress: false
  # Replication listener for workers — compose-internal only, never published
  # to the host. Workers reach it over the compose network at synapse:9093.
  - port: 9093
    type: http
    tls: false
    bind_addresses: ["0.0.0.0"]
    resources:
      - names: [replication]

# Worker support (ADR 0002 amendment). Redis is the replication backbone. Two
# axes are sharded off the main process:
#   - READS:  generic "sync" workers serve /sync etc. (the collab fan-out).
#   - WRITES: an event-persister stream writer owns the `events` stream.
# instance_map lists every process that owns a stream (main + each writer) by
# its replication listener; stream_writers assigns streams to them. Scale by
# adding more sync workers and/or event persisters (events shard across the
# list) — roughly one machine's worth of cores per added worker. Other
# low-volume streams (typing, receipts, to_device, account_data, presence) stay
# on main; split them the same way if they ever become hot.
redis:
  enabled: true
  host: redis
  port: 6379

instance_map:
  main:
    host: synapse
    port: 9093
  persister1:
    host: synapse-persister1
    port: 9094

stream_writers:
  events:
    - persister1

# DO managed Postgres (tier-2 secrets). verify-full encrypts the link AND
# authenticates the server against the cluster CA (db-ca.crt, shipped in the
# deploy bundle and mounted at /data) — defeats MITM on the public endpoint.
database:
  name: psycopg2
  args:
    user: "${PG_USER}"
    password: "${PG_PASSWORD}"
    dbname: synapse
    host: "${PG_HOST}"
    port: ${PG_PORT}
    sslmode: verify-full
    sslrootcert: /data/db-ca.crt
    # Pool sized for the SHARED managed-Postgres budget (max_connections=25):
    # FOUR Synapse processes now (main + 2 sync workers + 1 event persister) each
    # open up to cp_max, alongside MAS (capped at 5 in mas/config.yaml.tmpl) and
    # DO's own connections. cp_max=2 → 8 Synapse + 5 MAS + ~3 admin ≈ 16 of 25.
    # This is the validation ceiling: real load needs a bigger PG plan or a
    # PgBouncer pooler (see infra/README.md "Scaling") — the droplet and PG scale
    # independently, and the connection budget — not cores — caps worker count.
    cp_min: 1
    cp_max: 2

# Auth is delegated to MAS (MSC3861) — Synapse does no registration or
# password handling itself. Registration happens only through MAS, which is
# closed except via the subscribe flow (ADR 0002).
enable_registration: false
password_config:
  enabled: false

experimental_features:
  msc3861:
    enabled: true
    issuer: "https://auth.tidework.io/"
    client_id: "0000000000000000000SYNAPSE"
    client_auth_method: client_secret_basic
    client_secret: "${MAS_SYNAPSE_CLIENT_SECRET}"
    admin_token: "${MAS_ADMIN_TOKEN}"
    account_management_url: "https://auth.tidework.io/account"

trusted_key_servers:
  - server_name: "matrix.org"

# Reclaim workspaces nobody is in any more.
#
# Matrix has no delete-a-room operation: a room persists as long as any member
# remains. What a client CAN do is leave and then forget it, which is what
# `leaveWorkspace()` does. This setting is the other half — Synapse purges a
# room from the database once every local user has forgotten it, so an
# abandoned or deleted workspace stops costing storage instead of lingering
# forever. Without it, forgetting only hides the room.
#
# 28 days is a deliberate grace period: a purge is irreversible, and a user who
# left by mistake can be re-invited within the window and still have history.
# (`forget_rooms_on_leave` is left off — our client forgets explicitly, so
# auto-forgetting every left room would be a broader policy than we want.)
forgotten_room_retention_period: 28d

# Media limits — generous enough for document workspaces, bounded for a 4GB box.
max_upload_size: 50M
