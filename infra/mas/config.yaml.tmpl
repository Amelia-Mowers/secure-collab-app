# MAS (Matrix Authentication Service) configuration for TideWork.
# Rendered by infra/deploy.sh with envsubst. MAS's generated secrets
# (encryption key, signing keys) live in /srv/tidework/mas/secrets.yaml on
# the droplet — created once at first deploy by `mas-cli config generate`
# and passed as a second --config file; they never enter this repo.

http:
  public_base: "https://auth.tidework.io/"
  issuer: "https://auth.tidework.io/"
  listeners:
    - name: web
      resources:
        - name: discovery
        - name: human
        - name: oauth
        - name: compat
        - name: graphql
        - name: assets
        # Admin REST API for the billing Worker (token issuance, lock/unlock).
        # Gated: only clients in policy.data.admin_clients can mint
        # urn:mas:admin tokens, via client_credentials with their secret.
        - name: adminapi
      binds:
        - address: "[::]:8080" # container-internal; published on 127.0.0.1 only
      proxy_protocol: false
    - name: internal
      resources:
        - name: health
      binds:
        - address: "[::]:8081"
      proxy_protocol: false
  trusted_proxies:
    - 172.16.0.0/12 # docker bridge — host nginx forwards through it

database:
  uri: "postgresql://${PG_USER}:${PG_PASSWORD}@${PG_HOST}:${PG_PORT}/mas?sslmode=require"

matrix:
  homeserver: "tidework.io"
  secret: "${MAS_ADMIN_TOKEN}"
  endpoint: "http://synapse:8008/"

# The static OAuth client Synapse uses to talk to MAS (documented convention id).
clients:
  - client_id: "0000000000000000000SYNAPSE"
    client_auth_method: client_secret_basic
    client_secret: "${MAS_SYNAPSE_CLIENT_SECRET}"
  # The billing Worker (Stripe ↔ MAS): client_credentials only, allowlisted
  # for the admin API below. Secret is tier-2 (sops) + a Worker secret.
  - client_id: "00000000000000000000STR1PE"
    client_auth_method: client_secret_basic
    client_secret: "${MAS_BILLING_CLIENT_SECRET}"

passwords:
  enabled: true

# Registration happens ONLY with a single-use token issued by the billing
# Worker after Stripe checkout (ADR 0002 phase D) — or operator-created via
# `mas-cli manage register-user`.
account:
  password_registration_enabled: true
  registration_token_required: true
  email_change_allowed: false

# Allow the billing client to use the admin API (urn:mas:admin).
policy:
  data:
    admin_clients:
      - "00000000000000000000STR1PE"

email:
  from: '"TideWork" <noreply@tidework.io>'
  reply_to: '"TideWork" <noreply@tidework.io>'
  transport: blackhole # no email provider yet — revisit before launch
