# MAS (Matrix Authentication Service) configuration for TideWork.
# Rendered by infra/deploy.sh with envsubst. MAS's generated secrets
# (encryption key, signing keys) live in /srv/tidework/mas/secrets.yaml on
# the droplet — created once at first deploy by `mas-cli config generate`
# and passed as a second --config file; they never enter this repo.

http:
  public_base: "https://auth.tidework.io/"
  issuer: "https://auth.tidework.io/"
  listeners:
    - name: web
      resources:
        - name: discovery
        - name: human
        - name: oauth
        - name: compat
        - name: graphql
        - name: assets
        # Admin REST API for the billing Worker (token issuance, lock/unlock).
        # Gated: only clients in policy.data.admin_clients can mint
        # urn:mas:admin tokens, via client_credentials with their secret.
        - name: adminapi
      binds:
        - address: "[::]:8080" # container-internal; published on 127.0.0.1 only
      proxy_protocol: false
    - name: internal
      resources:
        - name: health
      binds:
        - address: "[::]:8081"
      proxy_protocol: false
  trusted_proxies:
    - 172.16.0.0/12 # docker bridge — host nginx forwards through it

# verify-full: encrypt + authenticate the server against the DO cluster CA
# (db-ca.crt mounted at /config). sqlx parses sslrootcert from the URL.
# max_connections capped so MAS leaves room in the shared 25-connection managed
# Postgres budget for Synapse's 4 worker processes (see synapse/homeserver.yaml
# .tmpl). Raise alongside the PG plan when scaling.
database:
  uri: "postgresql://${PG_USER}:${PG_PASSWORD}@${PG_HOST}:${PG_PORT}/mas?sslmode=verify-full&sslrootcert=/config/db-ca.crt"
  max_connections: 5
  min_connections: 1

matrix:
  homeserver: "tidework.io"
  secret: "${MAS_ADMIN_TOKEN}"
  endpoint: "http://synapse:8008/"

# The static OAuth client Synapse uses to talk to MAS (documented convention id).
clients:
  - client_id: "0000000000000000000SYNAPSE"
    client_auth_method: client_secret_basic
    client_secret: "${MAS_SYNAPSE_CLIENT_SECRET}"
  # The billing Worker (Stripe ↔ MAS): client_credentials only, allowlisted
  # for the admin API below. Secret is tier-2 (sops) + a Worker secret.
  - client_id: "00000000000000000000STR1PE"
    client_auth_method: client_secret_basic
    client_secret: "${MAS_BILLING_CLIENT_SECRET}"

passwords:
  enabled: true

# Registration attempts are token-gated anyway, so the IP rate limit mainly
# protects against form spam — the default is strict enough to lock out a
# NAT'd office; allow a burst with slow refill instead.
rate_limiting:
  registration:
    burst: 10
    per_second: 0.016

# Open registration with a 14-day trial (ADR 0002 phase D, amended): the
# billing Worker's sweep locks unpaid accounts past the trial. Escalation
# valves if registration is ever flooded: MAS-native CAPTCHA (Turnstile),
# or flip registration_token_required back on (emergency brake).
account:
  password_registration_enabled: true
  email_change_allowed: false

# Upstream social / enterprise login (ADR 0002 phase F — "by config, no code").
# MAS renders the provider buttons on its hosted sign-in pages, so the app needs
# NO changes. Each provider's client_id/secret are tier-2 secrets
# (upstream-oauth.sops.env); when absent, remote-setup.sh drops the provider so
# MAS still boots. Register this redirect URI with the provider:
#   https://auth.tidework.io/upstream/callback/<id>
# The id MUST stay a ULID and must match the registered redirect URI.
upstream_oauth2:
  providers:
    - id: 1VAQ5RSM5FDRKEJMP69N81JBPW
      human_name: Google
      brand_name: "google"
      issuer: "https://accounts.google.com"
      token_endpoint_auth_method: client_secret_post
      client_id: "${GOOGLE_OAUTH_CLIENT_ID}"
      client_secret: "${GOOGLE_OAUTH_CLIENT_SECRET}"
      scope: "openid profile email"
      # Always show Google's account chooser. Without this, Chrome silently
      # reuses whichever Google session is already signed in, so a user who
      # lands on "this account is locked" has no way to try a different one —
      # the upstream never asks. `select_account` makes that a choice.
      additional_authorization_parameters:
        prompt: "select_account"
      claims_imports:
        localpart:
          action: ignore
        displayname:
          action: suggest
          template: "{{ user.name }}"
        email:
          action: suggest
          template: "{{ user.email }}"
        account_name:
          template: "{{ user.email }}"

# Allow the billing client to use the admin API (urn:mas:admin).
policy:
  data:
    admin_clients:
      - "00000000000000000000STR1PE"

# Terms and privacy. `tos_uri` is not merely a link: MAS adds a MANDATORY
# checkbox to registration and records which document the user accepted in its
# `user_terms` table — so consent is captured at the point it is given, on the
# page where registration actually happens (MAS's, not the app's). Both are also
# advertised to clients via OIDC metadata (op_tos_uri / op_policy_uri) and
# appear in the footer of MAS's emails.
#
# Changing either URL is not free: a new tos_uri means existing users are asked
# to accept again, which is the correct behaviour for a material change and the
# wrong one for a typo fix.
branding:
  service_name: TideWork
  # Shown in the footer of every MAS page, including the ERROR page a locked
  # account hits when it tries to sign in. That page is otherwise a dead end:
  # no account chooser, no reactivate link, no support address — and the user
  # who most wants to pay is the one who cannot reach any payment surface.
  # The app's TrialGate does offer a subscribe button, but only to a session
  # already in localStorage; a FRESH sign-in never gets that far.
  imprint: "Locked out? Reactivate at https://tidework.io/reactivate or email tideworksupport@proton.me"
  tos_uri: https://tidework.io/terms
  policy_uri: https://tidework.io/privacy

# Transactional email via Resend (verification codes, password resets).
# Domain-authenticated (SPF/DKIM on tidework.io); username is literally
# "resend", the password is the API key (tier-2 sops: email.sops.env).
email:
  from: '"TideWork" <noreply@tidework.io>'
  reply_to: '"TideWork" <noreply@tidework.io>'
  transport: smtp
  mode: tls
  hostname: smtp.resend.com
  # 2465 = Resend's alternate TLS port — DigitalOcean blocks standard SMTP
  # ports (25/465/587) on droplets.
  port: 2465
  username: resend
  password: "${SMTP_PASSWORD}"
