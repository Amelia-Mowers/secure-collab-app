# Shell-sensitive files must use LF, even on Windows checkouts. CRLF in
# flake.nix breaks the Nix dev-shell hook (`fi\r` doesn't close `if`, and
# get-env.sh then fails to produce an environment).
*.nix    text eol=lf
*.sh     text eol=lf
Makefile text eol=lf

# Rust sources are LF by convention. Pin it so editors/tools on Windows can't
# silently reintroduce CRLF and churn the whole file on the next `cargo fmt`
# (bridge_matrix.rs drifted to CRLF this way before being normalized).
*.rs     text eol=lf

# CA cert: store verbatim (LF), never normalize — it's shipped as-is to the
# droplet and mounted into the Synapse/MAS containers for sslmode=verify-full.
infra/db-ca.crt -text
